<?xml version="1.0" encoding="utf-8"?>
<!-- Controls cloud backup and device-to-device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="ironmind.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ironmind.db" />
    </device-transfer>
</data-extraction-rules>
