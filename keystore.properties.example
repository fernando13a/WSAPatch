# IronMind Release Signing Configuration
#
# Copy this file to keystore.properties and fill in your keystore details
# to enable release builds signed with your own key.
#
# IMPORTANT: Keep keystore.properties private and never commit it to version control.
# Add it to .gitignore if not already there.

# Path to your release keystore file (relative to project root)
storeFile=keystore.jks

# Password for the keystore
storePassword=your_keystore_password

# Alias of the key inside the keystore
keyAlias=ironmind-release-key

# Password for the specific key
keyPassword=your_key_password
